# Lifeboat watcher configuration. Copy to .env and fill in.

# Required
RPC_URL=http://127.0.0.1:8545
VAULT_ADDRESS=0xYourDeployedVaultAddress

# Optional: POST a JSON alert to this URL on every WithdrawalRequested
# WEBHOOK_URL=https://hooks.example.com/lifeboat

# Optional: polling interval for the event subscription (ms)
# POLL_MS=1000

# Optional "panic freeze": broadcast a pre-signed revokeHotKey on the first alert.
# Produce PANIC_FILE on your own device with `pnpm --filter @lifeboat/watcher prepare-panic`
# (needs KEYFILE = your serialized LifeboatSigner). The signature can only disable the hot
# key — it can never move funds — so a compromised watcher can at worst grief, not steal.
# PANIC_FILE=panic.json
# RELAYER_PK=0x...   # funds the panic transaction's gas
